{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "cd backend && npm install --production=false && node debug-railway-deploy.js && echo '✅ Build completed'"
  },
  "deploy": {
    "startCommand": "cd backend && node server-minimal.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "region": "us-west1"
  },
  "envVars": {
    "NODE_ENV": {
      "default": "production"
    },
    "NPM_CONFIG_PRODUCTION": {
      "default": "false"
    },
    "NODE_OPTIONS": {
      "default": "--max-old-space-size=512"
    }
  }
}