# APES Backend Environment Variables Template
# Copy this file to .env and fill in the actual values
# NEVER commit .env files to git!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Use ONE of the following database configurations:

# Option 1: Full connection string (recommended for production)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Option 2: Individual database parameters
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_NAME=your-database-name
# DB_USER=your-username
# DB_PASSWORD=your-secure-password

# Supabase Configuration (if using Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=5001

# Security Configuration
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your-very-secure-random-jwt-secret-at-least-32-characters

# ===========================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ===========================================
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Production Solana Configuration (use in production)
# SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://your-secure-rpc-endpoint

# Smart Contract Configuration
APES_PROGRAM_ID=APESCaeLW5RuxNnpNARtDZnSgeVFC5f37Z3VFNKupJUS
APES_TOKEN_MINT=9BZJXtmfPpkHnM57gHEx5Pc9oQhLhJtr4mhCsNtttTts

# Treasury Configuration
APES_TREASURY=APEShoBNNvnM4JV6pW51vb8X4Cq6ZeZy6DqfjmTu6j4z

# ===========================================
# ADMIN CONFIGURATION (SECURE)
# ===========================================
# Comma-separated list of authorized admin wallet addresses
ADMIN_WALLETS=wallet1,wallet2,wallet3

# Deployer private key for automated deployments (Base64 encoded)
# IMPORTANT: Only use in secure environments, never commit this
# DEPLOYER_PRIVATE_KEY=your-base64-encoded-private-key

# ===========================================
# API KEYS
# ===========================================
# Believe API Configuration
BELIEVE_APP_API_KEY=your-believe-api-key

# Twitter/X OAuth Configuration
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_CALLBACK_URL=http://localhost:3000/auth/twitter/callback
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
PRIMAPE_TWITTER_ID=your-primape-twitter-account-id

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# LOGGING AND MONITORING
# ===========================================
LOG_LEVEL=info

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit this file with actual values to git
# 2. Use strong, unique passwords for all services
# 3. Rotate keys regularly
# 4. Use environment-specific configurations
# 5. Monitor access logs for suspicious activity 