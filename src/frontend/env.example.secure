# APES Frontend Environment Variables Template
# Copy this file to .env and fill in the actual values
# NEVER commit .env files to git!

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
# Development Configuration
VITE_SOLANA_NETWORK=devnet
VITE_RPC_URL=https://api.devnet.solana.com

# Production Configuration (uncomment for production)
# VITE_SOLANA_NETWORK=mainnet-beta
# VITE_RPC_URL=https://your-secure-mainnet-rpc-endpoint

# WebSocket Configuration
VITE_WS_URL=wss://api.devnet.solana.com/

# ===========================================
# SMART CONTRACT CONFIGURATION
# ===========================================
VITE_PROGRAM_ID=APESCaeLW5RuxNnpNARtDZnSgeVFC5f37Z3VFNKupJUS
VITE_TOKEN_MINT=9BZJXtmfPpkHnM57gHEx5Pc9oQhLhJtr4mhCsNtttTts
VITE_TOKEN_DECIMALS=9

# Treasury Configuration
VITE_PRIMAPE_TREASURY=APEShoBNNvnM4JV6pW51vb8X4Cq6ZeZy6DqfjmTu6j4z
VITE_COMMUNITY_TREASURY=APESxbwPNyJW62vSY83zENJwoL2gXJ8HbpMBPWwJKGi2

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API URL
VITE_API_URL=http://localhost:5001

# Production API URL (uncomment for production)
# VITE_API_URL=https://your-production-api-url.com

# ===========================================
# THIRD-PARTY SERVICES
# ===========================================
# Believe API Configuration
VITE_BELIEVE_API_KEY=your-believe-api-key
VITE_BELIEVE_API_URL=https://public.believe.app/v1

# RPC Provider API Keys
VITE_HELIUS_API_KEY=your-helius-api-key
VITE_ALCHEMY_API_KEY=your-alchemy-api-key

# ===========================================
# FEATURE FLAGS
# ===========================================
# Environment identifier
VITE_ENVIRONMENT=development

# Debug mode
VITE_DEBUG=true

# Twitter/X integration
VITE_TWITTER_ENABLED=true

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. NEVER include private keys or sensitive admin data in frontend env
# 2. All VITE_ variables are exposed to the browser
# 3. Admin wallet lists should NOT be in frontend environment
# 4. Use backend API for admin authentication
# 5. Rotate API keys regularly 